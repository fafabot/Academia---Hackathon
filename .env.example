# Configuração do Firebase Web App para o projeto academia-aura
# Obtenha estes valores no Console do Firebase > Configurações do Projeto > Seus Aplicativos
# Ou execute: npx firebase-tools apps:sdkconfig WEB <APP_ID> --project academia-aura

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=academia-aura.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=academia-aura
VITE_FIREBASE_STORAGE_BUCKET=academia-aura.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
